# Copy this file to .env and fill in your real keys.
# Do not commit the real .env file.

# Required. Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_actual_tmdb_key_here

# Optional. From https://console.anthropic.com/
# Without this, the app still runs and shows the top TMDB matches.
ANTHROPIC_API_KEY=your_actual_anthropic_key_here
